    { "id": "H_Animar", "actor": "HMI 3D · planta emulada", "texto": "Mover cintas, paleta y baliza según %QX", "tipo": "accion", "bpmn": "serviceTask" },
    { "id": "H_Estado", "actor": "HMI 3D · planta emulada", "texto": "¿Estado publicado?", "tipo": "decision" },
