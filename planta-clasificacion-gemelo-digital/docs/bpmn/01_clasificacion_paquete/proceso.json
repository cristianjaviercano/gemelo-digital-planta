    { "id": "P_S3", "actor": "PLC · FSM de clasificación", "texto": "S3 · Clasificar ruta B (T5)", "tipo": "accion" },
    { "id": "P_Salidas", "actor": "PLC · FSM de clasificación", "texto": "Escribir %QX (λ) y heartbeat", "tipo": "accion", "bpmn": "serviceTask" }
