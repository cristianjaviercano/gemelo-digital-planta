    { "id": "P_Leer", "actor": "PLC · FSM de clasificación", "texto": "Leer %IX y evaluar δ en el ciclo de scan (10 ms)", "tipo": "accion", "bpmn": "serviceTask" },
    { "id": "P_Emergencia", "actor": "PLC · FSM de clasificación", "texto": "¿Emergencia activa?", "tipo": "decision" },
    { "id": "P_S4", "actor": "PLC · FSM de clasificación", "texto": "S4 · Parada de emergencia (T1)", "tipo": "accion" },
    { "id": "P_Flanco", "actor": "PLC · FSM de clasificación", "texto": "¿Flanco del sensor en S1?", "tipo": "decision" },
    { "id": "P_S1", "actor": "PLC · FSM de clasificación", "texto": "S1 · Esperando paquete (T2, T6)", "tipo": "accion" },
    { "id": "P_Destino", "actor": "PLC · FSM de clasificación", "texto": "¿Destino d muestreado?", "tipo": "decision" },
