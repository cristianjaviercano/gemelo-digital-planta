<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="SILOGE BPMN Modeler" exporterVersion="3.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Clasificación de un paquete gobernada por PLC" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Operador">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_Destino</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_Marcha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_Paquete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_Rearme</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="HMI 3D · planta emulada">
        <bpmn:flowNodeRef>H_Comando</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_Animar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_Estado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_Haz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_Desviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_Correcto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_Mal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Middleware Modbus–WebSocket">
        <bpmn:flowNodeRef>M_Escribir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Leer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Vivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Degradar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="PLC · FSM de clasificación">
        <bpmn:flowNodeRef>P_Leer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Emergencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Flanco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Destino</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Salidas</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Planta en reposo (S0)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="O_Destino" name="Seleccionar destino A/B">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="O_Marcha" name="Pulsar Marcha">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="O_Paquete" name="Generar paquete en la cinta de entrada">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="O_Rearme" name="Liberar la seta y pulsar Parada (rearme)">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="H_Comando" name="Enviar comando JSON por WebSocket">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="H_Animar" name="Mover cintas, paleta y baliza según %QX">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H_Estado" name="¿Estado publicado?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="H_Haz" name="Detectar paquete en el haz (AABB) y emitir sensorEntrada">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="H_Desviar" name="Desviar según la posición física de la paleta y despachar">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H_Correcto" name="¿Ruta igual al destino muestreado?">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fin_OK" name="Paquete despachado por su ruta">
      <bpmn:incoming>Flow_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fin_Mal" name="Paquete mal clasificado">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_Fin_Mal" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="M_Escribir" name="Validar en lista blanca y escribir coil (FC05)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="M_Leer" name="Leer FC01 y FC02 cada 50 ms y difundir estado">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_Vivo" name="¿PLC vivo? (conexión y heartbeat)">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="M_Degradar" name="Degradación segura y reconexión con FC15">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P_Leer" name="Leer %IX y evaluar δ en el ciclo de scan (10 ms)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P_Emergencia" name="¿Emergencia activa?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P_S4" name="S4 · Parada de emergencia (T1)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P_Flanco" name="¿Flanco del sensor en S1?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P_S1" name="S1 · Esperando paquete (T2, T6)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P_Destino" name="¿Destino d muestreado?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P_S2" name="S2 · Clasificar ruta A (T4)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P_S3" name="S3 · Clasificar ruta B (T5)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="P_Salidas" name="Escribir %QX (λ) y heartbeat">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Inicio" targetRef="O_Destino" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="O_Destino" targetRef="O_Marcha" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="O_Marcha" targetRef="H_Comando" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="H_Comando" targetRef="M_Escribir" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="M_Escribir" targetRef="P_Leer" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="P_Leer" targetRef="P_Emergencia" />
    <bpmn:sequenceFlow id="Flow_7" name="Sí" sourceRef="P_Emergencia" targetRef="P_S4" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="P_Emergencia" targetRef="P_Flanco" />
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="P_Flanco" targetRef="P_S1" />
    <bpmn:sequenceFlow id="Flow_10" name="Sí" sourceRef="P_Flanco" targetRef="P_Destino" />
    <bpmn:sequenceFlow id="Flow_11" name="d = 0" sourceRef="P_Destino" targetRef="P_S2" />
    <bpmn:sequenceFlow id="Flow_12" name="d = 1" sourceRef="P_Destino" targetRef="P_S3" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="P_S1" targetRef="P_Salidas" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="P_S2" targetRef="P_Salidas" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="P_S3" targetRef="P_Salidas" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="P_S4" targetRef="P_Salidas" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="P_Salidas" targetRef="M_Leer" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="M_Leer" targetRef="M_Vivo" />
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="M_Vivo" targetRef="M_Degradar" />
    <bpmn:sequenceFlow id="Flow_20" name="Reintento" sourceRef="M_Degradar" targetRef="M_Leer" />
    <bpmn:sequenceFlow id="Flow_21" name="Sí" sourceRef="M_Vivo" targetRef="H_Animar" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="H_Animar" targetRef="H_Estado" />
    <bpmn:sequenceFlow id="Flow_23" name="Esperando paquete" sourceRef="H_Estado" targetRef="O_Paquete" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="O_Paquete" targetRef="H_Haz" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="H_Haz" targetRef="H_Comando" />
    <bpmn:sequenceFlow id="Flow_26" name="Clasificando" sourceRef="H_Estado" targetRef="H_Desviar" />
    <bpmn:sequenceFlow id="Flow_27" name="Emergencia" sourceRef="H_Estado" targetRef="O_Rearme" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="O_Rearme" targetRef="H_Comando" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="H_Desviar" targetRef="H_Correcto" />
    <bpmn:sequenceFlow id="Flow_30" name="Sí" sourceRef="H_Correcto" targetRef="Fin_OK" />
    <bpmn:sequenceFlow id="Flow_31" name="No" sourceRef="H_Correcto" targetRef="Fin_Mal" />
  </bpmn:process>
