# Esclavo Modbus TCP: plc-virtual (macOS) → 5020.
# Laboratorio SILOGE (CODESYS, puerto 502): usar windows/puente-modbus-planta.env
MODBUS_HOST=127.0.0.1
MODBUS_PORT=5020
MODBUS_UNIT_ID=1
MODBUS_TIMEOUT_MS=2000
# Ciclo de adquisición
POLL_INTERVAL_MS=50
HEARTBEAT_STALE_MS=1500
PULSE_WIDTH_MS=150
# Reconexión con retroceso exponencial
RECONNECT_BASE_MS=500
RECONNECT_MAX_MS=5000
# Servidor WebSocket (127.0.0.1 = solo este equipo; 0.0.0.0 = accesible desde la red del laboratorio)
WS_HOST=127.0.0.1
WS_PORT=8080
# Registro estructurado (trace|debug|info|warn|error)
LOG_LEVEL=info
